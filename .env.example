# YTAGENT — Current US Trending-Topic Explanation Pipeline
GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_data_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
VIDEO_PRIVACY=public

# Optional tuning
DISCOVERY_WINDOW_HOURS=72
DISCOVERY_RESULTS_PER_SOURCE=50
DISCOVERY_MAX_PAGES=2
DISCOVERY_CANDIDATE_LIMIT=40

# Optional — only needed when using ElevenLabs instead of Edge TTS
ELEVENLABS_API_KEY=your_elevenlabs_key_here

GEMINI_TASK_MAX_RETRIES=2
GEMINI_TASK_RETRY_BASE_SECONDS=8
